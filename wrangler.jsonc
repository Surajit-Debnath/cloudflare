{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "super-bush-e020",
	"main": "src/index.ts",
	"compatibility_date": "2026-11-18",
	"assets": {
		"binding": "ASSETS",
		"directory": "./public"
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"d1_databases": [
		{
			"binding": "suro",
			"database_name": "suro",
			"database_id": "e61bfb5f-c735-428f-aebc-71a435851e6e",
			"remote": true
		}
	],
	"kv_namespaces": [
		{
			"binding": "CACHE1",
			"id": "1198aec835b446d481bdce9d5ab68f05"
		}
	]
}